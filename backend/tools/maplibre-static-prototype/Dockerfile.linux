# Build the unmodified repository Dockerfile as ogm-native-api-base:prototype first.
FROM node:22-bookworm-slim AS node
FROM ogm-native-api-base:prototype
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && apt-get update && apt-get install -y --no-install-recommends \
 libegl1 libgles2 libopengl0 libgl1-mesa-dri xvfb xauth mesa-utils \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/map-prototype
COPY backend/tools/maplibre-static-prototype/package*.json ./
RUN npm ci
COPY backend/tools/maplibre-static-prototype/*.mjs backend/tools/maplibre-static-prototype/*.json ./
ENV LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe
CMD ["xvfb-run", "-a", "sh", "-c", "glxinfo -B && mkdir -p output && npm run demo"]
